+    /// Average current core clock in MHz, read from the kernel cpufreq sysfs
+    /// (`scaling_cur_freq`, reported in kHz). Returns 0.0 if cpufreq is
+    /// unavailable (e.g. no scaling driver), in which case the value is hidden.
+    fn read_avg_freq_mhz() -> f64 {
+        let Ok(entries) = std::fs::read_dir("/sys/devices/system/cpu/cpufreq") else {
+            return 0.0;
+        };
+
+        let mut sum_khz: u64 = 0;
+        let mut count: u64 = 0;
+        for entry in entries.flatten() {
+            let name = entry.file_name();
+            // Only per-policy dirs (policy0, policy1, ...); skip boost/etc.
+            if !name.to_string_lossy().starts_with("policy") {
+                continue;
+            }
+            let path = entry.path().join("scaling_cur_freq");
+            if let Ok(contents) = std::fs::read_to_string(&path) {
+                if let Ok(khz) = contents.trim().parse::<u64>() {
+                    sum_khz += khz;
+                    count += 1;
+                }
+            }
+        }
+
+        if count == 0 {
+            0.0
+        } else {
+            (sum_khz as f64 / count as f64) / 1000.0
+        }
+    }
+
+    /// Current average clock formatted compactly for the panel/value text
+    /// (e.g. "4.8G", "0.6G"). None when cpufreq is unavailable, so callers can
+    /// omit it entirely.
+    pub fn freq_string(&self) -> Option<String> {
+        if self.freq_mhz <= 0.0 {
+            None
+        } else if self.freq_mhz >= 1000.0 {
+            Some(format!("{:.1}G", self.freq_mhz / 1000.0))
+        } else {
+            Some(format!("{:.0}M", self.freq_mhz))
+        }
+    }
